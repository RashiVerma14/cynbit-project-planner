# Application Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cynbit_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cynbit_project_planner

# Security & JWT Tokens
JWT_SECRET=cynbit_enterprise_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Groq Cloud AI Integration (Optional - Falls back to rule-based engine if omitted)
# Obtain free API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origins (Comma separated for multiple, or * for all)
CORS_ORIGIN=http://localhost:5173,https://cynbit-project-planner.vercel.app
